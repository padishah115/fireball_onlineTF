   ],
   "source": [
    "# INPUT CONFIGURATION\n",
    "\n",
    "input = {\n",
    "    \"DEVICE_NAME\": \"SCOPE 1\",\n",
    "    \"DEVICE_TYPE\": \"PROBE\",\n",
    "    \"DEVICE_SPECIES\": \"PROBE\",\n",
    "    \n",
    "    \"EXP_SHOT_NOS\": [0, 1, 2],\n",
    "    \"BKG_SHOT_NOS\": [3],\n",
    "    \n",
    "    \"BKG_NAME\": \"DARKFIELD\",\n",
    "    \"BACKGROUND_STATUS\": \"RAW\",\n",
    "\n",
    "    \"NORM_PLOT\": False,\n",
    "    \n",
    "    \"OPERATIONS\": {\n",
    "        \"SHOW_SINGLESHOT_PLOTS\": True,\n",
    "        \"LINEOUT_BIN_NO\": 100,\n",
    "        \"SHOW_AVERAGE_SHOTS\": True\n",
    "    },\n",
    "\n",
    "    \"PARENT_DIR\":\"/eos/project/h/hiradmat/HRMT Experiments/2025/HRMT68 - FIREBALL 3/FB3 repository/HRMT68_data\",\n",
    "\n",
    "    \"FOLDER_NAMES\": {\n",
    "            \"ANDOR SPECTROMETER\":\"andor_spectrometer\",\n",
    "            \"ORCA\":\"orca_streak\",\n",
    "            \"PLASMA CAMS\":\"plasmacell_cams\",\n",
    "            \"SCOPE 1\":\"scope_test\",\n",
    "            \"SCOPE 2\":\"scope_test\",\n",
    "            \"SCOPE 3\":\"scope_test\",\n",
    "            \"LDV\":\"ldv_and_strain_gauges/Triggers/2025/05/23\"\n",
    "\n",
    "    },\n",
    "\n",
    "    \"EXTENSION_DICT\" : {\n",
    "            \"ANDOR SPECTROMETER\": \".tif\",\n",
    "            \"ORCA\": \".dac\",\n",
    "            \"PLASMA CAMS\": \".csv\",\n",
    "            \"SCOPE 1\": \".csv\",\n",
    "            \"SCOPE 2\": \".csv\",\n",
    "            \"SCOPE 3\": \".csv\",\n",
    "            \"LDV\": \".tdms\",\n",
    "        },\n",
    "\n",
    "    # Which part of the filename string (SLICE) encodes time data? use this to sort files in a directory with most recent first.\n",
    "    \"TIMESTAMP_SLICE\": {\n",
    "            \"ANDOR SPECTROMETER\": (4, 9),\n",
    "            \"ORCA\": None,\n",
    "            \"PLASMA CAMS\": (57, 72),\n",
    "            \"SCOPE 1\": (-21, -4),\n",
    "            \"SCOPE 2\": (-21, -4),\n",
    "            \"SCOPE 3\": (-21, -4),\n",
    "            \"LDV\": None,\n",
    "    } \n",
    "    \n",
    "}\n",
    "\n",
    "print(\"Executed\")"
   ]
  },
