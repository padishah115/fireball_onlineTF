      "\u001b[0;32m/eos/home-i02/h/hramm/fireball_onlineTF/utils/runmanager/camrunmanager.py\u001b[0m in \u001b[0;36mrun\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m     61\u001b[0m         \u001b[0;31m# DICTIONARIES OF FORM {SHOT NO : {\"DATA\": [], \"X\": [], \"Y\": []}} FOR IMAGES\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     62\u001b[0m         \u001b[0;31m# AND OF FORM {SHOT NO : { \"DATA\": { \"VOLTAGES\":[], \"TIMES\":[] } } } FOR PROBES\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 63\u001b[0;31m         \u001b[0mraw_data_dict\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mbkg_data_dict\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcorrected_data_dict\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mload_manager\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     64\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     65\u001b[0m         \u001b[0;31m##############################\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n",
      "\u001b[0;32m/eos/home-i02/h/hramm/fireball_onlineTF/utils/loadmanager/camloadmanager.py\u001b[0m in \u001b[0;36mload\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m     31\u001b[0m         \u001b[0;31m# CHECK TO MAKE SURE THAT WE ACTUALLY WANT BACKGROUND SHOTS TO ENTER THE FRAY\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     32\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0minput\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0;34m\"BACKGROUND_STATUS\"\u001b[0m\u001b[0;34m]\u001b[0m \u001b[0;34m!=\u001b[0m \u001b[0;34m\"RAW\"\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 33\u001b[0;31m             bkg_data_dict : Dict = self.IMAGE_load_shots(self.bkg_shot_nos, \n\u001b[0m\u001b[1;32m     34\u001b[0m                                                 \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mdata_paths_dict\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     35\u001b[0m                                                 camera_type=self.input[\"DEVICE_SPECIES\"])\n",
      "\u001b[0;32m/eos/home-i02/h/hramm/fireball_onlineTF/utils/loadmanager/camloadmanager.py\u001b[0m in \u001b[0;36mIMAGE_load_shots\u001b[0;34m(self, shot_nos, data_paths_dict, camera_type)\u001b[0m\n\u001b[1;32m    223\u001b[0m         \u001b[0;32mfor\u001b[0m \u001b[0mshot_no\u001b[0m \u001b[0;32min\u001b[0m \u001b[0mshot_nos\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    224\u001b[0m             \u001b[0;31m#LOCATE SHOT'S DATA PATH FROM THE DATA_PATHS_DICT\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 225\u001b[0;31m             \u001b[0mdata_path\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mdata_paths_dict\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0mshot_no\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    226\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    227\u001b[0m             \u001b[0;31m# STORE THE DATA ITSELF FOR EACH SHOT IN THE IMAGE_DICT ARRAY\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n",
