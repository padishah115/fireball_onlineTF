from utils.opmanager.operationsmanager import OperationsManager

from nptdms import TdmsFile
import matplotlib.pyplot as plt
import numpy as np
from scipy.fft import rfftfreq, rfft

class LDVOperationsManager(OperationsManager):
    
    def __init__(self, DEVICE_NAME, shot_no, label, shot_data, input, std_data = None):
        super().__init__(DEVICE_NAME, shot_no, label, shot_data, input, std_data)
        
        #Initialise key varibles
        # TIME IN SECONDS, SAMPLE NUMBER, TIMESTEP
        self.times = self.shot_data["timestamp"]
        self.N = int(len(self.times))
        self.dt = float(self.times[1]-self.times[0])


        # DISPLACEMENT OF THE LDV IN UM
        self.ldv_position = self.shot_data["POS_LDV"]
        self.ldv_position_freq, self.ldv_position_ftransform = self._get_fft(self.ldv_position)

        # LDV VELOCITY IN MM/S
        self.ldv_speed = self.shot_data["SPEED_LDV"]
        
        # STRAIN GAUGE READINGS IN PPM
        self.strain_gauge_center = self.shot_data["StrainGaugeCenter"]
        self.strain_gauge_center_freq, self.strain_gauge_center_ftransform = self._get_fft(self.strain_gauge_center)
        
        self.strain_gauge_downstream = self.shot_data["StrainGaugeDownstream"]
        self.strain_gauge_downstream_freq, self.strain_gauge_downstream_ftransform = self._get_fft(self.strain_gauge_downstream)

    def plot(self):
        """Produces plots for LDV data- this includes the position and velocity of the LDV data as a function of time, as well as upstream           and central strain gauge readings. We produce these as 2x2 plots."""

        #######################################
        # LOAD DATA FROM SHOT DATA DICTIONARY #
        #######################################

        fig, axs = plt.subplots(4, 2, figsize=(16,9))

        # LDV POSITION VS TIME
        axs[0, 0].plot(self.times, self.ldv_position)
        axs[0, 0].set_title("LDV Position")
        axs[0, 0].set_xlabel("Time / s")
        axs[0, 0].set_ylabel("Displacement / um")
        axs[0, 0].grid()
        # FT OF POSITION VS TIME
        axs[0, 1].plot(self.ldv_position_freq, self.ldv_position_ftransform)
        axs[0, 1].set_title("LDV Position Fourier Transform")
        axs[0, 1].set_xlabel("Freq / Hz")
        axs[0, 1].set_ylabel("Fourier Amplitude")
        axs[0, 1].grid()

        # LDV SPEED VS TIME
        axs[1, 0].plot(self.times, self.ldv_speed)
        axs[1, 0].set_title("LDV Velocity")
        axs[1, 0].set_xlabel("Time / s")
        axs[1, 0].set_ylabel("Velocity / mm s^-1")
        axs[1, 0].grid()

        axs[2,0].axis("off")
        
        # CENTRAL GAUGE POSITION VS TIME
        axs[2, 0].plot(self.times, self.strain_gauge_center)
        axs[2, 0].set_title("Strain Gauge (Center)")
        axs[2, 0].set_xlabel("Time / s")
        axs[2, 0].set_ylabel("Strain / ppm")
        axs[2, 0].grid()
        # FT OF CENTRAL GAUGE
        axs[2, 1].plot(self.strain_gauge_center_freq, self.strain_gauge_center_ftransform)
        axs[2, 1].set_title("Strain Gauge (Center) Fourier Transform")
        axs[2, 1].set_xlabel("Frequency / Hz")
        axs[2, 1].set_ylabel("Fourier Amplitude")
        axs[2, 1].grid()
        
        # DOWNSTREAM GAUGE POSITION VS TIME
        axs[3, 0].plot(self.times, self.strain_gauge_downstream)
        axs[3, 0].set_title("Strain Gauge (Downstream)")
        axs[3, 0].set_xlabel("Time / s")
        axs[3, 0].set_ylabel("Strain / ppm")
        axs[3, 0].grid()
        # FT OF DOWNSTREAM GAUGE
        axs[3, 1].plot(self.strain_gauge_center_freq, self.strain_gauge_center_ftransform)
        axs[3, 1].set_title("Strain Gauge (Downstream) Fourier Transform")
        axs[3, 1].set_xlabel("Frequency / Hz")
        axs[3, 1].set_ylabel("Fourier Amplitude")
        axs[3, 1].grid()

        fig.suptitle(f"LDV and String Gauge Data, Shot No {self.shot_no}")
        fig.tight_layout()
        plt.show()


    def _get_fft(self, data_series):
        """Fast fourier transform for the LDV position and velocity data.

        Parameters
        ----------
            data_series : np.ndarray
                The data which we would like to fourier transform- this can be either the displacement, or the gauge data.

        Returns
        -------
            fft_freq : np.ndarray
                X-axis array for Fourier transform graph.
            fft_ampl : np.ndarray
                Y-axis array for Fourier transform graph.
        """

        
        # FOURIER TRANSFORM
        fft_freq = rfftfreq(n=self.N, d=self.dt)
        fft_amp = np.abs(rfft(data_series))

        return fft_freq, fft_amp
